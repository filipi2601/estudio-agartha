---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  hover?: boolean;
  variant?: 'listing' | 'showcase';
  desktopFit?: 'contain' | 'cover';
}

const { src, alt, hover = false, variant = 'listing', desktopFit = 'cover' } = Astro.props;
---

<Image src={src} alt={alt} loading="lazy"
  class:list={[
    'h-auto w-full',
    variant === 'listing' ? 'md:h-[375px]' : 'md:h-72',
    desktopFit === 'contain' ? 'md:object-contain' : 'md:object-cover',
    hover && 'transition-transform duration-300 group-hover:scale-105',
  ]} />
