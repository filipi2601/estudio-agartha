---
/**
 * SEO Component
 * Gerencia todas as meta tags e dados estruturados para uma página
 * 
 * Uso:
 * <SEO 
 *   title="Página"
 *   description="Descrição"
 *   image="/img/projetos/sheldon/1.png"
 *   url="https://example.com/page"
 *   type="article|organization|webpage"
 *   author="Nome do autor"
 *   publishedDate="2024-01-01"
 * />
 */

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: 'article' | 'organization' | 'webpage' | 'product';
  author?: string;
  publishedDate?: string;
  modifiedDate?: string;
  noindex?: boolean;
  locale?: import('../i18n/ui').Locale;
}

const {
  title,
  description,
  image = '/social-preview.png',
  url = Astro.url.href,
  type = 'webpage',
  author = 'Estúdio Agartha',
  publishedDate,
  modifiedDate,
  noindex = false,
  locale = 'pt',
} = Astro.props;

import { locales, localizedPath, ui } from '../i18n/ui';
const copy = ui[locale];
const socialImage = new URL(image, Astro.site).href;
const isDefaultImage = image === '/social-preview.png';

// Montando dados estruturados JSON-LD
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Estúdio Agartha',
  'description': description,
  'url': 'https://studioagartha.com',
  'logo': 'https://studioagartha.com/favicon.ico',
  'sameAs': [
    'https://www.instagram.com/agarthaestudio/',
    'https://www.linkedin.com/in/paulo-ricardo-930a72219',
    'https://t.me/Studioagartha'
  ],
  'contactPoint': {
    '@type': 'ContactPoint',
    'contactType': 'Customer Service',
    'email': 'contatos@studioagartha.com',
    'availableLanguage': locales.map((item) => ui[item].htmlLang)
  }
};
---

<!-- Meta Tags Essenciais -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="author" content={author} />

<!-- Canonical URL -->
<link rel="canonical" href={url} />
{locales.map((item) => (
  <link rel="alternate" hreflang={ui[item].htmlLang} href={new URL(localizedPath(Astro.url.pathname, item), Astro.site).href} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localizedPath(Astro.url.pathname, 'pt'), Astro.site).href} />

<!-- Robots -->
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

<!-- Open Graph (Facebook, LinkedIn, etc) -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={isDefaultImage ? 'Estúdio Agartha' : title} />
{isDefaultImage && <meta property="og:image:type" content="image/png" />}
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
<meta property="og:url" content={url} />
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:locale" content={copy.ogLocale} />
<meta property="og:site_name" content="Estúdio Agartha" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!-- Metadata adicional para artigos -->
{publishedDate && <meta property="article:published_time" content={publishedDate} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{author && <meta property="article:author" content={author} />}

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" />

<!-- Structured Data JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Preconnect para performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
