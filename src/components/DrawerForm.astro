---
import { localePath, ui, type Locale } from '../i18n/ui';
import { ArrowRight } from '@lucide/astro';
interface Props { locale?: Locale }
const { locale = 'pt' } = Astro.props;
const copy = ui[locale];
const messages = {
  pt: { intro: 'Conte um pouco sobre seu projeto. Responderemos pelo e-mail informado.', project: 'Sobre o projeto', deadline: 'Prazo desejado (opcional)', budget: 'Orçamento previsto (opcional)', privacy: 'Seus dados serão usados para responder ao contato. Leia a', privacyLink: 'Política de Privacidade' },
  en: { intro: 'Tell us about your project. We will reply to the email provided.', project: 'About the project', deadline: 'Desired deadline (optional)', budget: 'Estimated budget (optional)', privacy: 'Your details will be used to answer your enquiry. Read our', privacyLink: 'Privacy Policy' },
  es: { intro: '¿Eres editorial, autor o marca? Cuéntanos qué necesitas, tanto si se trata de un libro como de identidad visual, web, packaging o contenido digital. Responderemos al correo indicado.', project: 'Sobre el proyecto', deadline: 'Plazo deseado (opcional)', budget: 'Presupuesto estimado (opcional)', privacy: 'Usaremos tus datos para responder a tu consulta. Consulta nuestra', privacyLink: 'Política de privacidad' },
}[locale];
---

<div id="contactOverlay" class="pointer-events-none fixed inset-0 z-40 bg-black/40 opacity-0 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>
<aside id="contactOffcanvas" role="dialog" aria-modal="true" class="fixed top-0 right-0 z-50 flex h-dvh w-full max-w-lg translate-x-full flex-col bg-white shadow-2xl transition-transform duration-300 ease-out" aria-hidden="true" aria-labelledby="contactTitle">
  <div class="flex shrink-0 items-center justify-between border-b border-gray-100 px-6 py-5">
    <h2 id="contactTitle" class="text-xl font-semibold text-[#333]">{copy.formTitle}</h2>
    <button type="button" id="closeContact" class="rounded-lg p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-[#333]" aria-label={copy.closeMenu}>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="overflow-y-auto px-6 py-6">
    <p class="mb-6 text-sm leading-relaxed text-gray-600">{messages.intro}</p>
    <form id="contactForm" action="https://formsubmit.co/contatos@studioagartha.com" method="POST">
      <input type="hidden" name="_subject" value="Novo contato pelo site | Estúdio Agartha" />
      <input type="hidden" name="_url" value={Astro.url.href} />
      <input type="hidden" name="idioma" value={locale} />
      <div class="mb-5">
        <label for="contactName" class="mb-2 block text-sm font-medium text-[#333]">{copy.name}</label>
        <input id="contactName" name="nome" type="text" autocomplete="name" required maxlength="120" class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-[#00a69c] focus:ring-2 focus:ring-[#00a69c]/10" />
      </div>
      <div class="mb-5">
        <label for="contactEmail" class="mb-2 block text-sm font-medium text-[#333]">Email</label>
        <input id="contactEmail" name="email" type="email" autocomplete="email" required maxlength="254" class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-[#00a69c] focus:ring-2 focus:ring-[#00a69c]/10" />
      </div>
      <fieldset class="mb-5">
        <legend class="mb-2 block text-sm font-medium text-[#333]">{copy.desiredServices}</legend>
        <div class="flex flex-wrap gap-2">
          {copy.serviceItems.map(([service]) => (
            <label class="cursor-pointer rounded-xl border border-gray-200 px-4 py-2.5 text-sm text-gray-600 has-checked:border-[#00a69c] has-checked:bg-[#00a69c] has-checked:text-white focus-within:ring-2 focus-within:ring-[#00a69c]">
              <input class="sr-only" type="checkbox" name="servicos" value={service} />{service}
            </label>
          ))}
        </div>
      </fieldset>
      <div class="mb-5">
        <label for="contactProject" class="mb-2 block text-sm font-medium text-[#333]">{messages.project}</label>
        <textarea id="contactProject" name="projeto" rows="5" required maxlength="4000" class="w-full resize-y rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-[#00a69c] focus:ring-2 focus:ring-[#00a69c]/10"></textarea>
      </div>
      <div class="mb-5 grid gap-4 sm:grid-cols-2">
        <div><label for="contactDeadline" class="mb-2 block text-sm font-medium text-[#333]">{messages.deadline}</label><input id="contactDeadline" name="prazo" type="text" maxlength="100" class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-[#00a69c]" /></div>
        <div><label for="contactBudget" class="mb-2 block text-sm font-medium text-[#333]">{messages.budget}</label><input id="contactBudget" name="orcamento" type="text" maxlength="100" class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-[#00a69c]" /></div>
      </div>
      <p class="mb-5 text-xs leading-relaxed text-gray-600">{messages.privacy} <a class="text-[#008f87] underline" href={localePath(locale, 'privacy')}>{messages.privacyLink}</a>.</p>
      <p id="contactStatus" class="mb-4 hidden text-sm" role="status" aria-live="polite"></p>
      <button id="contactSubmit" type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00a69c] px-5 py-3.5 font-medium text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#008f87] disabled:cursor-wait disabled:opacity-70">
        <span id="contactSubmitLabel">{copy.send}</span><ArrowRight class="h-4 w-4" aria-hidden="true" />
      </button>
      <p class="mt-4 text-center text-xs text-gray-600"><a href="mailto:contatos@studioagartha.com" class="text-[#008f87] underline">contatos@studioagartha.com</a></p>
    </form>
  </div>
</aside>

<script>
  const drawer = document.getElementById('contactOffcanvas');
  const overlay = document.getElementById('contactOverlay');
  const form = document.querySelector<HTMLFormElement>('#contactForm');
  const submitButton = document.querySelector<HTMLButtonElement>('#contactSubmit');
  const submitLabel = document.getElementById('contactSubmitLabel');
  const status = document.getElementById('contactStatus');
  let previousFocus: HTMLElement | null = null;
  const messages = {
    pt: { sending: 'Enviando…', success: 'Mensagem enviada. Obrigado pelo contato!', error: 'Não foi possível enviar. Tente novamente ou escreva para contatos@studioagartha.com.' },
    en: { sending: 'Sending…', success: 'Message sent. Thank you for contacting us!', error: 'Could not send your message. Please try again or email contatos@studioagartha.com.' },
    es: { sending: 'Enviando…', success: 'Mensaje enviado. ¡Gracias por escribirnos!', error: 'No se ha podido enviar. Inténtalo de nuevo o escribe a contatos@studioagartha.com.' },
  }[document.documentElement.lang.startsWith('es') ? 'es' : document.documentElement.lang.startsWith('en') ? 'en' : 'pt'];

  function openContactDrawer() {
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    drawer?.classList.remove('translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    drawer?.setAttribute('aria-hidden', 'false');
    overlay?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('overflow-hidden');
    document.getElementById('contactName')?.focus();
  }
  function closeContactDrawer() {
    drawer?.classList.add('translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    drawer?.setAttribute('aria-hidden', 'true');
    overlay?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('overflow-hidden');
    previousFocus?.focus();
  }
  document.querySelectorAll('.js-open-contact').forEach((button) => button.addEventListener('click', openContactDrawer));
  document.addEventListener('open-contact', openContactDrawer);
  document.getElementById('closeContact')?.addEventListener('click', closeContactDrawer);
  overlay?.addEventListener('click', closeContactDrawer);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeContactDrawer(); });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !submitButton || !submitLabel || !status) return;
    submitButton.disabled = true;
    const previousText = submitLabel.textContent;
    submitLabel.textContent = messages.sending;
    status.classList.add('hidden');
    try {
      const formData = new FormData(form);
      const payload: Record<string, string> = Object.fromEntries(formData.entries()) as Record<string, string>;
      payload.servicos = formData.getAll('servicos').join(', ');
      payload._replyto = payload.email;
      const response = await fetch(form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/'), { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) });
      const result = await response.json();
      if (!response.ok || String(result.success) !== 'true') throw new Error('Submission failed');
      form.reset();
      status.textContent = messages.success;
      status.className = 'mb-4 text-sm text-[#008f87]';
      document.dispatchEvent(new CustomEvent('contact-submitted'));
    } catch {
      status.textContent = messages.error;
      status.className = 'mb-4 text-sm text-red-700';
    } finally {
      submitButton.disabled = false;
      submitLabel.textContent = previousText;
    }
  });
</script>
