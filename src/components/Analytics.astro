---
import { localePath, type Locale } from '../i18n/ui';
const { locale } = Astro.props as { locale: Locale };
const copy = {
  pt: { settings: 'Preferências de cookies', text: 'Podemos usar cookies do Google Analytics para entender as visitas e os contatos recebidos? Você pode recusar e continuar usando o site normalmente.', accept: 'Aceitar', reject: 'Recusar', privacy: 'Privacidade' },
  en: { settings: 'Cookie preferences', text: 'May we use Google Analytics cookies to understand visits and enquiries? You can decline and continue using the website normally.', accept: 'Accept', reject: 'Decline', privacy: 'Privacy' },
  es: { settings: 'Preferencias de cookies', text: '¿Podemos usar cookies de Google Analytics para entender las visitas y las consultas? Puedes rechazarlas y seguir usando el sitio con normalidad.', accept: 'Aceptar', reject: 'Rechazar', privacy: 'Privacidad' },
}[locale];
---
<div class="pb-6 text-center">
  <button id="analytics-settings" type="button" class="text-xs text-ink-muted underline">{copy.settings}</button>
</div>
<aside id="analytics-consent" hidden aria-label={copy.settings} class="fixed inset-x-4 bottom-4 z-[100] mx-auto max-w-xl rounded-2xl border border-gray-200 bg-white p-5 shadow-lg">
  <p class="text-sm leading-6 text-ink-muted">{copy.text} <a href={localePath(locale, 'privacy')} class="text-brand-strong underline">{copy.privacy}</a>.</p>
  <div class="mt-4 flex gap-3">
    <button id="analytics-accept" type="button" class="rounded-lg border border-brand-strong px-5 py-2 text-sm text-brand-strong">{copy.accept}</button>
    <button id="analytics-reject" type="button" class="rounded-lg border border-brand-strong px-5 py-2 text-sm text-brand-strong">{copy.reject}</button>
  </div>
</aside>
<script is:inline>
(() => {
  const id = 'G-BK38XHQQYC';
  const key = 'agartha-analytics-consent';
  const banner = document.getElementById('analytics-consent');
  let consent = null;
  let loaded = false;
  const query = new URLSearchParams(location.search);
  let internal = query.get('analytics_test') === '1';
  try {
    if (query.get('analytics_test') === '1') localStorage.setItem('agartha-analytics-test', '1');
    if (query.get('analytics_test') === '0') localStorage.removeItem('agartha-analytics-test');
    internal = internal || localStorage.getItem('agartha-analytics-test') === '1';
  } catch {}
  const excluded = internal || !['studioagartha.com', 'www.studioagartha.com'].includes(location.hostname);
  const pageUrl = new URL(location.origin + location.pathname);
  const campaign = {};
  for (const [parameter, field] of Object.entries({ utm_source: 'campaign_source', utm_medium: 'campaign_medium', utm_campaign: 'campaign_name', utm_content: 'campaign_content', utm_term: 'campaign_term', utm_id: 'campaign_id' })) {
    const value = query.get(parameter);
    // Campaign labels are public tokens; never forward arbitrary query parameters.
    if (value && /^[a-z0-9_-]{1,80}$/.test(value)) {
      pageUrl.searchParams.set(parameter, value);
      campaign[field] = value;
    }
  }
  const projectPage = /^\/(?:en\/|es\/)?projects\/[a-z0-9-]+\/?$/;
  try { consent = localStorage.getItem(key); } catch {}
  window.dataLayer = window.dataLayer || [];
  function gtag() { window.dataLayer.push(arguments); }
  gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });

  function enable() {
    if (excluded) return;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    if (loaded) return;
    loaded = true;
    gtag('js', new Date());
    gtag('config', id, {
      page_location: pageUrl.href,
      page_referrer: document.referrer.split('?')[0].split('#')[0],
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
      send_page_view: true,
      ...campaign
    });
    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
    document.head.appendChild(script);
    if (projectPage.test(location.pathname)) track('project_view', { project_path: location.pathname });
  }
  function choose(value) {
    consent = value;
    try { localStorage.setItem(key, value); } catch {}
    if (value === 'granted') enable();
    else {
      gtag('consent', 'update', { analytics_storage: 'denied' });
      // Reload after revocation so the already-loaded tag stops running.
      if (loaded) location.reload();
    }
    banner.hidden = true;
  }
  function track(name, details = {}) {
    if (consent !== 'granted' || excluded || !loaded) return;
    gtag('event', name, { send_to: id, site_language: document.documentElement.lang, page_location: pageUrl.href, ...details });
  }
  if (consent === 'granted') enable();
  else banner.hidden = consent === 'denied';
  document.getElementById('analytics-accept').addEventListener('click', () => choose('granted'));
  document.getElementById('analytics-reject').addEventListener('click', () => choose('denied'));
  document.getElementById('analytics-settings').addEventListener('click', () => { banner.hidden = false; document.getElementById('analytics-accept').focus(); });
  document.addEventListener('contact-opened', () => track('contact_open', { contact_page: location.pathname }));
  document.addEventListener('contact-submitted', () => track('generate_lead', { contact_page: location.pathname }));
  document.addEventListener('click', (event) => {
    const anchor = event.target?.closest?.('a[href]');
    if (!anchor) return;
    const target = new URL(anchor.href, location.origin);
    if (target.origin === location.origin && projectPage.test(target.pathname)) {
      track('project_click', { project_path: target.pathname });
    }
  });
})();
</script>
