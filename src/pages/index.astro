---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from '../layouts/Layout.astro';
import ProjectThumbnail from '../components/ProjectThumbnail.astro';
import { ArrowDown, ArrowRight, BookOpen, Globe2, Megaphone, Package, Palette } from "@lucide/astro";
import Galeria1 from "../assets/img/galeria-1.png";
import Galeria2 from "../assets/img/galeria-2.png";
import MarcaLuan from "../assets/img/marcas/luan-cavalcanti.png";
import MarcaStAnthony from "../assets/img/marcas/st-anthony.png";
import MarcaSheldon from "../assets/img/marcas/sheldon.png";
import MarcaTernario from "../assets/img/marcas/ternario.png";
import { localePath, localizeProject, ui, type Locale } from '../i18n/ui';

interface Props { locale?: Locale }
const { locale = 'pt' } = Astro.props;
const copy = ui[locale];
const journey = copy.journey.map(([title, text]) => ({ title, text }));

const gallery = [
	{ src: Galeria1, alt: 'Sheldon', href: localePath(locale, 'projects/sheldon'), title: 'Sheldon' },
	{ src: Galeria2, alt: 'Amana', href: localePath(locale, 'projects/amana'), title: 'Amana' }
];

const recentProjectIds = ['a-doutrina-sufi', 'arte-cavalheiresca-do-arqueiro-zen', 'a-alma-do-indio'];
const allProjects = await getCollection('projects');
const projects = recentProjectIds.flatMap((id) => allProjects.filter((project) => project.id === id));
const projectCategory = (project: (typeof projects)[number]) =>
    localizeProject(locale, project.id, project.data.description, project.data.categories).categories[0];
const pageTitles = {
    pt: 'Design gráfico, editorial e identidade visual | Estúdio Agartha',
    en: 'Graphic, editorial and visual identity design | Estúdio Agartha',
    es: 'Diseño gráfico para marcas y editoriales | Estúdio Agartha',
};
const specialty = {
    pt: { label: 'Nossa especialidade', title: 'Design editorial que cuida de cada página', text: 'Capas, diagramação e projetos gráficos para livros e publicações. Também desenvolvemos identidade visual, sites, embalagens e conteúdo digital para marcas de diferentes setores.', cta: 'Conheça o serviço editorial' },
    en: { label: 'Our specialty', title: 'Editorial design that considers every page', text: 'Covers, layouts and graphic systems for books and publications. We also create visual identities, websites, packaging and digital content for brands in different industries.', cta: 'Explore editorial design' },
    es: { label: 'Nuestra especialidad', title: 'Diseño editorial que cuida cada página', text: 'Cubiertas, maquetación y proyectos gráficos para libros y publicaciones. También desarrollamos identidad visual, sitios web, packaging y contenido digital para marcas de distintos sectores.', cta: 'Conoce el servicio editorial' },
}[locale];
const contactPrompt = {
    pt: { title: 'Vamos conversar sobre seu projeto?', text: 'Se você representa uma editora, publica livros ou precisa de identidade visual, site, embalagem ou conteúdo para sua marca, conte-nos o que tem em mente.', cta: 'Conte seu projeto' },
    en: { title: 'Let’s talk about your project', text: 'Whether you represent a publisher, create books or need a visual identity, website, packaging or content for your brand, tell us what you have in mind.', cta: 'Tell us about your project' },
    es: { title: 'Hablemos de tu próximo proyecto', text: 'Si representas una editorial, publicas libros o necesitas identidad visual, un sitio web, packaging o contenido para tu marca en España, cuéntanos qué tienes en mente.', cta: 'Cuéntanos tu proyecto' },
}[locale];
const serviceIcon = (title: string) => {
    if (/editorial/i.test(title)) return BookOpen;
    if (/identidade visual|visual identity|identidad visual/i.test(title)) return Palette;
    if (/web/i.test(title)) return Globe2;
    if (/embalagem|packaging|embalaje/i.test(title)) return Package;
    return Megaphone;
};
---

<Layout title={pageTitles[locale]} description={copy.seoDescription} locale={locale}>
    <section class="flex min-h-[calc(100vh-110px)] flex-col items-center justify-center px-4 py-16 text-center">
        <h1 data-reveal class="text-[2.2rem] font-normal leading-[1.2] text-[#00a69c] sm:text-[3.5rem] md:text-[5rem]">
            {copy.heroTitle} <br />
            {copy.heroTitle2}
        </h1>

        <p data-reveal style="--reveal-delay: 100ms" class="mt-4 max-w-3xl text-base text-[#686d85] sm:text-[1.1rem]">
            {copy.heroText}
        </p>

        <button type="button"
            class="js-open-contact mt-8 rounded-lg bg-[#00a69c] px-8 py-3 text-white transition-colors duration-200 hover:bg-[#009186]">
            {copy.talk}
        </button>

        <div class="mt-16 text-3xl text-[#686d85]" aria-hidden="true">
            <ArrowDown class="animate-bounce w-10 h-10" />
        </div>
    </section>

      <section data-reveal class="my-10 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <p class="mb-2 text-sm uppercase tracking-[0.18em] text-[#00a69c]">{specialty.label}</p>
            <h2 class="text-2xl text-[#00a69c] sm:text-3xl">{specialty.title}</h2>
            <p class="mt-3 max-w-2xl leading-relaxed text-[#686d85]">{specialty.text}</p>
          </div>
          <a href={localePath(locale, 'diseno-editorial')} class="inline-flex items-center gap-2 rounded-xl bg-[#00a69c] px-6 py-3 font-medium text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#009186] hover:shadow-md">
            {specialty.cta}<ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </section>

    <section id="projetos" data-reveal class="my-5 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <div class="mx-auto max-w-7xl text-left">
            <h2 class="mb-8 text-xl sm:text-3xl text-[#00a69c]">
                {copy.recentProjects}
            </h2>

            <div class="grid gap-6 md:grid-cols-3">
                {projects.map((project) => (
                <article
                    class="overflow-hidden rounded-4xl bg-[#e1e4ed] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                    <ProjectThumbnail src={project.data.cover} alt={`Projeto ${project.data.title}`} />

                    <div class="px-5 py-5 text-center">
                        <h3 class="mb-1 text-base font-semibold text-[#00a69c]">
                            {project.data.title}
                        </h3>

                        <p class="mb-2 text-sm">
                            {projectCategory(project)}
                        </p>

                        <a href={localePath(locale, `projects/${project.id}`)}
                            class="inline-flex items-center gap-1 text-sm text-gray-500 transition-colors hover:text-[#00a69c]">
                            <span>{copy.knowProject}</span>
                            <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
                        </a>
                    </div>
                </article>
                ))}
            </div>

            <div class="mt-8 text-center">
                <a href={localePath(locale, 'projects')}
                    class="inline-flex rounded-xl bg-[#00a69c] px-6 py-2.5 font-medium text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#009186] hover:shadow-md">
                    {copy.allProjects}
                </a>
            </div>
        </div>
    </section>

    <section id="jornada" data-reveal class="my-10 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div>
                <ArrowDown class="w-20 h-20 text-[#00a69c] " style="transform: rotate(-45deg)" />
                <h2 class="text-[#00a69c] md:mb-0 text-center md:text-start text-3xl tracking-tight sm:text-4xl">
                    <br />
                    {copy.journeyTitle}
                </h2>
            </div>

            <div class="space-y-4">
                {journey.map((step) => (
                <details
                    class="group rounded-3xl border border-slate-100 bg-white px-5 py-4 open:shadow-[0_16px_40px_rgba(15,23,42,0.08)]">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg">
                        <span>{step.title}</span>
                        <span
                            class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 transition group-open:rotate-45 group-open:border-teal-200 group-open:bg-teal-50 group-open:text-teal-700">+</span>
                    </summary>
                    <p class="mt-4 max-w-3xl text-sm leading-7">{step.text}</p>
                </details>
                ))}
            </div>
        </div>
    </section>

    <section id="marcas" data-reveal class="my-10 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <h2 class="text-center mx-auto mb-10 max-w-3xl text-xl leading-tight text-[#00a69c] sm:text-3xl">
            {copy.brandsTitle}
        </h2>

        <div
            class="mx-auto grid max-w-5xl grid-cols-2 items-center justify-items-center gap-x-6 gap-y-8 md:grid-cols-4">

            <div class="flex h-24 w-full items-center justify-center">
                <Image src={MarcaLuan} alt="Luan Cavalcanti"
                    class="max-h-20 max-w-full object-contain transition-transform duration-300 hover:scale-105" />
            </div>

            <div class="flex h-24 w-full items-center justify-center">
                <Image src={MarcaStAnthony} alt="St. Anthony Books & Gifts"
                    class="max-h-20 max-w-full object-contain transition-transform duration-300 hover:scale-105" />
            </div>

            <div class="flex h-24 w-full items-center justify-center">
                <Image src={MarcaSheldon} alt="Sheldon - Calçados em Couro"
                    class="max-h-20 max-w-full object-contain transition-transform duration-300 hover:scale-105" />
            </div>

            <div class="flex h-24 w-full items-center justify-center">
                <Image src={MarcaTernario} alt="O Ternário da Vida Espiritual"
                    class="max-h-20 max-w-full object-contain transition-transform duration-300 hover:scale-105" />
            </div>

        </div>
    </section>

    <section id="servicos" data-reveal class="my-10 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <div class="mb-7 flex items-end justify-between gap-6">
            <div>
                <p class="mb-2 text-sm uppercase tracking-[0.18em] text-[#00a69c]">{copy.services}</p>
                <h2 class="text-3xl text-[#00a69c] sm:text-4xl">{copy.servicesTitle}</h2>
            </div>
            <ArrowDown class="hidden h-14 w-14 rotate-[-45deg] text-[#00a69c] sm:block" aria-hidden="true" />
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {copy.serviceItems.map(([title, text]) => {
                const ServiceIcon = serviceIcon(title);
                return (
                    <article class="group rounded-2xl border border-slate-100 bg-[#f7f8fa] p-5 transition-all duration-300 hover:-translate-y-1 hover:border-[#00a69c]/30 hover:bg-white hover:shadow-[0_14px_35px_rgba(15,23,42,0.08)]">
                        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-[#00a69c]/10 text-[#00a69c] transition-transform duration-300 group-hover:rotate-[-4deg] group-hover:scale-105">
                            <ServiceIcon class="h-5 w-5" aria-hidden="true" />
                        </div>
                        <h3 class="mb-2 text-lg text-[#00a69c]">{title}</h3>
                        <p class="text-sm leading-6 text-[#686d85]">{text}</p>
                        {/editorial/i.test(title) && <a href={localePath(locale, 'diseno-editorial')} class="mt-3 inline-flex text-sm text-[#008f87] underline">{locale === 'es' ? 'Conocer el servicio' : locale === 'en' ? 'Explore this service' : 'Conhecer o serviço'}</a>}
                        {/identidade visual|visual identity|identidad visual/i.test(title) && <a href={localePath(locale, 'branding')} class="mt-3 inline-flex text-sm text-[#008f87] underline">{locale === 'es' ? 'Conocer el servicio' : locale === 'en' ? 'Explore this service' : 'Conhecer o serviço'}</a>}
                    </article>
                );
            })}
        </div>
    </section>

    <section data-reveal class="my-10 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div>
                <h2 class="text-2xl text-[#00a69c] sm:text-3xl">{contactPrompt.title}</h2>
                <p class="mt-3 max-w-3xl leading-relaxed text-[#686d85]">{contactPrompt.text}</p>
            </div>
            <button type="button" class="js-open-contact shrink-0 self-start rounded-xl bg-[#00a69c] px-6 py-3 font-medium text-white transition-colors hover:bg-[#009186]">
                {contactPrompt.cta}
            </button>
        </div>
    </section>

    <section id="galeria" data-reveal
        class="mt-8 rounded-4xl border border-white/70 bg-white/75 px-6 py-10 shadow-[0_20px_80px_rgba(15,23,42,0.08)] sm:px-8 lg:px-10">
        <div class="text-center">
            <p class="text-sm uppercase tracking-[0.22em] text-teal-700">{copy.gallery}</p>
            <h2 class="mt-2 text-3xl tracking-tight text-slate-950 sm:text-4xl">{copy.galleryTitle}</h2>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
            {gallery.map((item) => (
            <a href={item.href} title={item.title} aria-label={item.title}
                class="group overflow-hidden rounded-4xl border border-slate-100 bg-white transition hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(15,23,42,0.12)]">
                <div class="aspect-16/10 overflow-hidden bg-slate-100">
                    <Image src={item.src} alt={item.alt}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                </div>
            </a>
            ))}
        </div>
    </section>
</Layout>
