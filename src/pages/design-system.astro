              <div class="mt-5 flex flex-wrap items-center justify-between gap-4"><Image src={Logo} alt="Estúdio Agartha" class="h-10 w-auto" /><div class="flex gap-4 text-ink-muted"><Icon name="mdi:instagram" class="h-5 w-5" aria-label="Instagram" /><Icon name="mdi:linkedin" class="h-5 w-5" aria-label="LinkedIn" /><Icon name="mdi:telegram" class="h-5 w-5" aria-label="Telegram" /></div></div>
