---
import '../styles/global.css';
import { Image } from 'astro:assets';
import ProjectThumbnail from '../components/ProjectThumbnail.astro';
import { ArrowDown, ArrowRight, ArrowUp, ArrowUpRight, BookOpen, ChevronDown, Globe2, Mail, Megaphone, Menu, Package, Palette, Quote, UserRound } from '@lucide/astro';
import { Icon } from 'astro-icon/components';
import Logo from '../assets/img/logo.png';
import Galeria1 from '../assets/img/galeria-1.png';
import SheldonCover from '../assets/img/projetos/sheldon/cover.png';
import { ui } from '../i18n/ui';

const colors = [
  { name: 'Brand', token: 'brand', value: '#00A69C', className: 'bg-brand' },
  { name: 'Ação', token: 'brand-strong', value: '#007A73', className: 'bg-brand-strong' },
  { name: 'Ativo', token: 'brand-active', value: '#006B66', className: 'bg-brand-active' },
  { name: 'Acento', token: 'brand-soft', value: '#8DCAC7', className: 'bg-brand-soft' },
  { name: 'Fundo', token: 'canvas', value: '#E5E5E5', className: 'bg-canvas' },
  { name: 'Superfície', token: 'surface-muted', value: '#E1E4ED', className: 'bg-surface-muted' },
  { name: 'Superfície suave', token: 'surface-soft', value: '#F7F8FA', className: 'bg-surface-soft' },
  { name: 'Texto', token: 'ink', value: '#333333', className: 'bg-ink' },
  { name: 'Texto secundário', token: 'ink-muted', value: '#686D85', className: 'bg-ink-muted' },
];

const fonts = [
  { name: 'Coolvetica', token: 'font-sans', className: 'font-sans', use: 'Identidade e interface padrão' },
  { name: 'Poppins', token: 'font-poppins', className: 'font-poppins', use: 'Textos longos e interface alternativa' },
  { name: 'Condensed', token: 'font-condensed', className: 'font-condensed', use: 'Títulos editoriais compactos' },
  { name: 'Compressed', token: 'font-compressed', className: 'font-compressed', use: 'Destaques de alto impacto' },
  { name: 'Crammed', token: 'font-crammed', className: 'font-crammed', use: 'Composição display excepcional' },
];
const interfaceIcons = [
  { name: 'Editorial', glyph: BookOpen },
  { name: 'Identidade visual', glyph: Palette },
  { name: 'Websites', glyph: Globe2 },
  { name: 'Embalagem', glyph: Package },
  { name: 'Social media', glyph: Megaphone },
  { name: 'Avançar', glyph: ArrowRight },
  { name: 'Contato', glyph: Mail },
  { name: 'Menu', glyph: Menu },
];
const [sampleServiceTitle, sampleServiceText] = ui.pt.serviceItems[0];
const componentInventory = [
  { name: 'Logo, navegação e idiomas', source: 'src/components/Header.astro', detail: 'Desktop, menu lateral mobile e alternância PT / EN / ES.' },
  { name: 'Hero, seções e chamadas', source: 'src/pages/index.astro', detail: 'Hierarquia, painéis brancos, CTAs e 40px entre seções.' },
  { name: 'Cards de serviços e jornada', source: 'src/pages/index.astro', detail: 'Superfície suave, ícones SVG, hover e painéis expansíveis.' },
  { name: 'Filtros e cartões de projeto', source: 'src/pages/projects/index.astro', detail: 'Estados selecionados, capa responsiva e link para o projeto.' },
  { name: 'Imagem de capa', source: 'src/components/ProjectThumbnail.astro', detail: 'Largura fluida e variantes de listagem ou destaque.' },
  { name: 'Breadcrumb, galeria e estudo de caso', source: 'src/pages/projects/[slug].astro', detail: 'Navegação centrada, conteúdo e imagens do projeto.' },
  { name: 'Galeria da home e marcas', source: 'src/pages/index.astro', detail: 'Imagens em grade, recorte da galeria e logos sem recorte.' },
  { name: 'Depoimentos', source: 'src/components/Testimonials.astro', detail: 'Rolagem automática, controles, seleção e pausa ao clicar.' },
  { name: 'Formulário lateral', source: 'src/components/DrawerForm.astro', detail: 'Campos, seleção de serviços, status e foco no painel.' },
  { name: 'Consentimento de métricas', source: 'src/components/Analytics.astro', detail: 'Aviso, aceitar ou recusar e ajustes posteriores.' },
  { name: 'Rodapé e redes sociais', source: 'src/components/Footer.astro', detail: 'CTA, logo, páginas, contato e links externos.' },
  { name: 'Páginas de serviço e privacidade', source: 'src/components/EditorialPage.astro · BrandingPage.astro · PrivacyPage.astro', detail: 'Painéis de conteúdo, cards de destaque e leitura longa.' },
  { name: 'Revelação e redução de movimento', source: 'src/layouts/Layout.astro · src/styles/global.css', detail: 'Entrada por rolagem, transições e acessibilidade de movimento.' },
];
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Prévia interna dos tokens e padrões visuais do Estúdio Agartha." />
    <link rel="icon" href="/favicon.ico" />
    <title>Design system | Estúdio Agartha</title>
  </head>
  <body class="bg-canvas text-ink antialiased">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">Pular para o conteúdo</a>

    <div class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
      <header class="flex flex-wrap items-center justify-between gap-4 border-b border-ink/10 py-6">
        <a href="/" class="inline-flex items-center gap-2 text-brand-strong hover:text-brand-active" aria-label="Voltar ao início do Estúdio Agartha"><Image src={Logo} alt="" class="h-10 w-auto" /><ArrowUpRight class="h-4 w-4" aria-hidden="true" /></a>
        <span class="rounded-full border border-ink/15 px-3 py-1 text-xs font-medium uppercase tracking-widest text-ink-muted">Laboratório visual · uso interno</span>
      </header>

      <main id="conteudo">
        <section data-reveal class="grid gap-8 py-14 md:grid-cols-[1.4fr_0.6fr] md:items-end md:py-20">
          <div>
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand-strong">Identidade em uso / 01</p>
            <h1 class="max-w-4xl text-5xl leading-[0.95] text-brand sm:text-7xl lg:text-8xl">Design<br />system.</h1>
            <p class="mt-6 max-w-2xl text-base leading-7 text-ink-muted">Uma visão prática das cores, fontes, formas e componentes do site. Use esta página para comparar decisões visuais antes de aplicá-las em novas telas.</p>
          </div>
          <p class="border-l-2 border-brand pl-5 text-sm leading-6 text-ink-muted">Fonte de verdade: <code class="text-ink">src/styles/global.css</code><br />Guia de uso: <code class="text-ink">docs/DESIGN_SYSTEM.md</code></p>
        </section>

        <nav aria-label="Seções do design system" class="mb-8 flex flex-wrap gap-2 text-sm">
          <a href="#cores" class="rounded-full bg-white px-4 py-2 text-ink hover:text-brand-strong">01 Cores</a>
          <a href="#tipografia" class="rounded-full bg-white px-4 py-2 text-ink hover:text-brand-strong">02 Tipografia</a>
          <a href="#icones" class="rounded-full bg-white px-4 py-2 text-ink hover:text-brand-strong">03 Ícones</a>
          <a href="#componentes" class="rounded-full bg-white px-4 py-2 text-ink hover:text-brand-strong">04 Componentes</a>
          <a href="#inventario" class="rounded-full bg-white px-4 py-2 text-ink hover:text-brand-strong">05 Inventário</a>
          <a href="#motion" class="rounded-full bg-white px-4 py-2 text-ink hover:text-brand-strong">06 Movimento</a>
          <a href="#composicao" class="rounded-full bg-white px-4 py-2 text-ink hover:text-brand-strong">07 Composição</a>
        </nav>

        <section id="cores" data-reveal aria-labelledby="cores-titulo" class="rounded-panel bg-white px-5 py-8 sm:px-8 sm:py-10">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div><p class="text-xs font-semibold uppercase tracking-widest text-brand-strong">01 / Fundação</p><h2 id="cores-titulo" class="mt-2 text-3xl text-ink sm:text-4xl">Cores com função</h2></div>
            <p class="max-w-sm text-sm leading-6 text-ink-muted">O turquesa vivo marca a identidade. Para links e botões com texto pequeno, use o tom de ação mais escuro.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {colors.map((color) => (
              <article class="overflow-hidden rounded-card border border-line">
                <div class:list={['h-24', color.className]} aria-hidden="true"></div>
                <div class="flex items-end justify-between gap-3 p-4">
                  <div><h3 class="text-lg text-ink">{color.name}</h3><code class="text-xs text-ink-muted">{color.token}</code></div>
                  <span class="text-xs text-ink-muted">{color.value}</span>
                </div>
              </article>
            ))}
          </div>
          <p class="mt-6 border-t border-line pt-5 text-sm text-ink-muted">Contraste sobre branco: <strong class="text-ink">brand 3,03:1</strong> para títulos grandes; <strong class="text-ink">brand-strong 5,21:1</strong> para texto normal.</p>
        </section>

        <section id="tipografia" data-reveal aria-labelledby="tipografia-titulo" class="mt-10 rounded-panel bg-white px-5 py-8 sm:px-8 sm:py-10">
          <div class="mb-8"><p class="text-xs font-semibold uppercase tracking-widest text-brand-strong">02 / Voz</p><h2 id="tipografia-titulo" class="mt-2 text-3xl text-ink sm:text-4xl">Tipografia</h2></div>
          <div class="grid gap-4 lg:grid-cols-2">
            {fonts.map((font) => (
              <article class="min-w-0 rounded-card bg-surface-soft p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-ink-muted"><span>{font.name}</span><code>{font.token}</code></div>
                <p class:list={['mt-5 break-words text-3xl leading-tight text-ink sm:text-4xl', font.className]}>Forma, ritmo &amp; significado.</p>
                <p class="mt-5 text-xs text-ink-muted">{font.use}</p>
              </article>
            ))}
          </div>
          <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <div class="rounded-card border border-line p-6"><p class="text-xs uppercase tracking-widest text-brand-strong">Coolvetica · padrão</p><p class="mt-4 text-lg leading-8 text-ink-muted">Uma identidade visual ganha força quando cada escolha tem uma função clara. A tipografia conduz a leitura e dá personalidade ao conteúdo.</p></div>
            <div class="rounded-card border border-line p-6 font-poppins"><p class="text-xs uppercase tracking-widest text-brand-strong">Poppins · alternativa</p><p class="mt-4 text-base leading-8 text-ink-muted">Uma identidade visual ganha força quando cada escolha tem uma função clara. A tipografia conduz a leitura e dá personalidade ao conteúdo.</p></div>
          </div>
          <h3 class="mt-8 text-2xl text-ink">Escala tipográfica da home</h3>
          <div class="mt-4 overflow-x-auto rounded-card border border-line">
            <table class="w-full min-w-[680px] border-collapse text-left text-sm">
              <caption class="sr-only">Tamanho, entrelinha e espaçamento entre letras dos textos da home</caption>
              <thead class="bg-surface-soft text-ink"><tr><th class="p-3 font-semibold">Uso</th><th class="p-3 font-semibold">Tamanho</th><th class="p-3 font-semibold">Entrelinha</th><th class="p-3 font-semibold">Espaçamento</th></tr></thead>
              <tbody class="text-ink-muted">
                <tr class="border-t border-line"><th scope="row" class="p-3 font-normal text-ink">Hero</th><td class="p-3">35,2 / 56 / 80 px</td><td class="p-3">1,2 · 42,24 / 67,2 / 96 px</td><td class="p-3">0,48 px</td></tr>
                <tr class="border-t border-line"><th scope="row" class="p-3 font-normal text-ink">Título de seção</th><td class="p-3">30 / 36 px</td><td class="p-3">36 / 40 px</td><td class="p-3">0,48 px</td></tr>
                <tr class="border-t border-line"><th scope="row" class="p-3 font-normal text-ink">Corpo de seção</th><td class="p-3">16 px</td><td class="p-3">26 px</td><td class="p-3">0,48 px</td></tr>
                <tr class="border-t border-line"><th scope="row" class="p-3 font-normal text-ink">Título de serviço</th><td class="p-3">18 px</td><td class="p-3">28 px</td><td class="p-3">0,48 px</td></tr>
                <tr class="border-t border-line"><th scope="row" class="p-3 font-normal text-ink">Descrição de serviço</th><td class="p-3">14 px</td><td class="p-3">21,7 px</td><td class="p-3">0,48 px</td></tr>
                <tr class="border-t border-line"><th scope="row" class="p-3 font-normal text-ink">Rótulo em caixa alta</th><td class="p-3">14 px</td><td class="p-3">20 px</td><td class="p-3">2,52 px</td></tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm leading-6 text-ink-muted">Tamanhos separados por barra correspondem a mobile, tablet e desktop. O espaçamento geral vem de <code>letter-spacing: 0.03em</code> no corpo (0,48 px); os rótulos usam <code>tracking-[0.18em]</code>. O kerning entre pares de letras é definido pela fonte e pelo navegador, sem ajuste manual global.</p>
        </section>

        <section id="icones" data-reveal aria-labelledby="icones-titulo" class="mt-10 rounded-panel bg-white px-5 py-8 sm:px-8 sm:py-10">
          <div class="mb-8"><p class="text-xs font-semibold uppercase tracking-widest text-brand-strong">03 / Símbolos</p><h2 id="icones-titulo" class="mt-2 text-3xl text-ink sm:text-4xl">Ícones em uso</h2></div>
          <p class="mb-5 max-w-3xl text-sm leading-6 text-ink-muted">Ícones de interface em SVG da biblioteca Lucide. A cor acompanha o texto; pictogramas decorativos não substituem o rótulo da ação.</p>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {interfaceIcons.map(({ name, glyph: Glyph }) => (
              <div class="flex items-center gap-3 rounded-card bg-surface-soft p-4 text-sm text-ink"><Glyph class="h-5 w-5 shrink-0 text-brand" aria-hidden="true" /><span>{name}</span></div>
            ))}
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-5 rounded-card border border-line p-4 text-sm text-ink">
            <span class="text-ink-muted">Redes sociais (SVG):</span>
            <span class="inline-flex items-center gap-2"><Icon name="mdi:instagram" class="h-5 w-5 text-brand" aria-hidden="true" />Instagram</span>
            <span class="inline-flex items-center gap-2"><Icon name="mdi:linkedin" class="h-5 w-5 text-brand" aria-hidden="true" />LinkedIn</span>
            <span class="inline-flex items-center gap-2"><Icon name="mdi:telegram" class="h-5 w-5 text-brand" aria-hidden="true" />Telegram</span>
          </div>
          <p class="mt-4 text-sm leading-6 text-ink-muted">Medidas em uso: 20 px nos serviços, 16 px em ações e contato, 14 px nas setas dos projetos e 24 px no menu mobile. Use SVG; não use emoji nem setas digitadas como substitutos de ícones.</p>
        </section>

        <section id="componentes" data-reveal aria-labelledby="componentes-titulo" class="mt-10 rounded-panel bg-white px-5 py-8 sm:px-8 sm:py-10">
          <div class="mb-8"><p class="text-xs font-semibold uppercase tracking-widest text-brand-strong">04 / Interface</p><h2 id="componentes-titulo" class="mt-2 text-3xl text-ink sm:text-4xl">Componentes em contexto</h2></div>
          <div class="grid gap-6 lg:grid-cols-2">
            <div class="rounded-card bg-surface-soft p-5 sm:p-6">
              <h3 class="text-2xl text-ink">Ações e estados</h3>
              <p class="mt-2 text-sm leading-6 text-ink-muted">Exemplos de ação primária, secundária, link e estado indisponível.</p>
              <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
                <a href="#composicao" class="rounded-xl bg-brand-strong px-5 py-3 font-medium text-white transition-colors hover:bg-brand-active">Ver composição</a>
                <a href="#tipografia" class="rounded-lg border border-brand-strong px-5 py-3 font-medium text-brand-strong transition-colors hover:bg-brand-tint">Comparar fontes</a>
                <button type="button" disabled class="rounded-xl bg-brand-strong px-5 py-3 text-white opacity-50">Indisponível</button>
              </div>
              <a href="/projects" class="mt-6 inline-block text-sm text-brand-strong underline underline-offset-4 hover:text-brand-active">Ver projetos reais</a>
            </div>

            <div class="rounded-card border border-line p-5 sm:p-6">
              <h3 class="text-2xl text-ink">Campos</h3>
              <p class="mt-2 text-sm leading-6 text-ink-muted">Amostra visual. Nenhum dado é enviado nesta página.</p>
              <div class="mt-5 grid gap-4 text-sm">
                <div><label for="demo-name" class="mb-2 block font-medium text-ink">Nome do projeto</label><input id="demo-name" type="text" placeholder="Ex.: nova coleção editorial" class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-ink outline-none placeholder:text-ink-muted/70 focus:border-brand focus:ring-2 focus:ring-brand/10" /></div>
                <div>
                  <span id="demo-type-label" class="mb-2 block font-medium text-ink">Tipo de trabalho</span>
                  <details class="group relative" data-demo-type>
                    <summary aria-labelledby="demo-type-label demo-type-value" class="flex w-full cursor-pointer list-none items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 text-ink [&::-webkit-details-marker]:hidden">
                      <span id="demo-type-value" data-selected-type>Design editorial</span><ChevronDown class="h-4 w-4 transition-transform group-open:rotate-180" aria-hidden="true" />
                    </summary>
                    <div class="absolute inset-x-0 z-10 mt-2 rounded-xl border border-line bg-white p-1 shadow-lg">
                      {['Design editorial', 'Identidade visual', 'Website'].map((type, index) => (
                        <button type="button" data-type-option aria-pressed={index === 0 ? 'true' : 'false'} class="block w-full rounded-lg px-3 py-2 text-left text-ink hover:bg-brand-tint focus-visible:bg-brand-tint">{type}</button>
                      ))}
                    </div>
                  </details>
                </div>
              </div>
            </div>

            <article class="mx-auto w-full max-w-sm overflow-hidden rounded-4xl bg-surface-muted shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
              <ProjectThumbnail src={SheldonCover} alt="Projeto Sheldon Calçados" />
              <div class="px-5 py-5 text-center">
                <h3 class="mb-1 text-base font-semibold text-brand">Sheldon Calçados</h3>
                <p class="mb-2 text-sm">Identidade Visual</p>
                <a href="/projects/sheldon" class="inline-flex items-center gap-1 text-sm text-gray-500 transition-colors hover:text-brand">Conhecer projeto <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" /></a>
              </div>
            </article>

            <div class="rounded-card bg-surface-soft p-5 sm:p-6">
              <h3 class="text-2xl text-ink">Detalhe expansível</h3>
              <p class="mt-2 text-sm leading-6 text-ink-muted">O navegador fornece a interação por teclado e o estado aberto.</p>
              <details class="mt-5 rounded-xl border border-line bg-white p-4 text-sm text-ink"><summary class="cursor-pointer font-medium">Quando usar Poppins?</summary><p class="mt-3 leading-6 text-ink-muted">Em textos mais longos ou interfaces que precisem de uma geometria tipográfica mais regular. Coolvetica segue como voz padrão do site.</p></details>
            </div>

            <article class="group rounded-2xl border border-slate-100 bg-surface-soft p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand/30 hover:bg-white hover:shadow-[0_14px_35px_rgba(15,23,42,0.08)]">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-tint text-brand transition-transform duration-300 group-hover:rotate-[-4deg] group-hover:scale-105"><Palette class="h-5 w-5" aria-hidden="true" /></div>
              <h3 class="mb-2 text-lg text-brand">{sampleServiceTitle}</h3>
              <p class="text-sm leading-[1.55] text-ink-muted">{sampleServiceText}</p>
              <a href="/branding" class="mt-3 inline-flex text-sm text-brand-strong underline">Conhecer o serviço</a>
            </article>

            <div class="rounded-card border border-line p-5 sm:p-6">
              <h3 class="text-2xl text-ink">Navegação e filtros</h3>
              <nav aria-label="Exemplo de breadcrumb" class="mt-4 text-sm"><ol class="flex flex-wrap items-center gap-2"><li><a href="/" class="text-brand hover:text-brand-active">Home</a></li><li>/</li><li><a href="/projects" class="text-brand hover:text-brand-active">Projetos</a></li><li>/</li><li aria-current="page">Sheldon Calçados</li></ol></nav>
              <div role="group" aria-label="Exemplo de filtros de projeto" class="mt-6 flex flex-wrap gap-2">
                <button type="button" data-demo-filter aria-pressed="true" class="rounded-xl border border-brand bg-brand-strong px-4 py-2 text-sm text-white transition-colors">Todos</button>
                <button type="button" data-demo-filter aria-pressed="false" class="rounded-xl border border-gray-200 px-4 py-2 text-sm text-ink transition-colors hover:border-brand">Editorial</button>
                <button type="button" data-demo-filter aria-pressed="false" class="rounded-xl border border-gray-200 px-4 py-2 text-sm text-ink transition-colors hover:border-brand">Identidade visual</button>
              </div>
            </div>

            <div class="rounded-card bg-surface-soft p-5 sm:p-6">
              <h3 class="text-2xl text-ink">Depoimento</h3>
              <div class="mt-5 rounded-card border border-line bg-surface-soft p-5">
                <Quote class="h-8 w-8 text-brand/40" aria-hidden="true" />
                <p class="my-4 text-sm leading-[1.7] text-ink-muted">Área reservada para um depoimento real e autorizado.</p>
                <div class="flex items-center gap-3 border-t border-line pt-4"><span class="grid h-14 w-14 place-items-center rounded-[14px] bg-brand-tint text-brand"><UserRound class="h-6 w-6" aria-hidden="true" /></span><span class="text-sm text-ink-muted">Nome e perfil do cliente</span></div>
              </div>
              <p class="mt-3 text-xs text-ink-muted">Prévia ainda não publicada na home: os cartões avançarão a cada 6s; clicar pausará e destacará o depoimento.</p>
            </div>

            <div class="rounded-card border border-line p-5 sm:p-6">
              <h3 class="text-2xl text-ink">Galeria e mídia</h3>
              <a href="/projects/sheldon" class="group mt-5 block overflow-hidden rounded-4xl"><div class="aspect-16/10 overflow-hidden bg-surface-soft"><Image src={Galeria1} alt="Peça visual do projeto Sheldon" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div></a>
              <p class="mt-3 text-sm text-ink-muted">Galeria: imagem em destaque com recorte. Logos de marcas: <code>object-contain</code> para preservar a marca inteira.</p>
            </div>

            <div class="rounded-card border border-line p-5 sm:p-6">
              <h3 class="text-2xl text-ink">Cabeçalho e idiomas</h3>
