---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
const { title, description, categories, images, cover } = project.data;

// Usar a imagem cover para OG image
const projectUrl = `https://studioagartha.com/projects/${project.id}`;
---

<Layout 
  title={`${title} | Estúdio Agartha`}
  description={description}
  image={cover.src}
  url={projectUrl}
  type="article"
  author="Estúdio Agartha"
>
    <main class="mx-auto max-w-6xl px-6 py-16">

        <!-- Breadcrumbs -->
        <nav class="mb-8 text-sm" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2">
            <li>
              <a href="/" class="text-[#00a69c] hover:text-[#009186] transition-colors">
                Home
              </a>
            </li>
            <li class="text-gray-400">/</li>
            <li>
              <a href="/projects" class="text-[#00a69c] hover:text-[#009186] transition-colors">
                Projetos
              </a>
            </li>
            <li class="text-gray-400">/</li>
            <li class="text-gray-600" aria-current="page">
              {title}
            </li>
          </ol>
        </nav>

        <!-- Cabeçalho -->
        <header class="mx-auto max-w-3xl text-center">

            <h1 class="text-4xl font-semibold tracking-tight text-gray-900 md:text-5xl">
                {title}
            </h1>

            <!-- Categorias -->
            <div class="mt-6 flex flex-wrap justify-center gap-2">
                {categories.map((category) => (
                <span class="rounded-full bg-[#009186] border border-gray-300 px-4 py-2 text-sm text-white">
                    {category}
                </span>
                ))}
            </div>

            <!-- Descrição -->
            <p class="mx-auto mt-8 max-w-xl text-lg leading-8 text-gray-600">
                {description}
            </p>

        </header>


        <!-- Imagens -->
        <section class="mt-16" aria-label="Galeria do projeto">
            <div class="flex flex-col gap-8">

                {images.length > 0 && (
                <div class="flex flex-col gap-8">
                    {images.map((image, index) => (
                    <Image 
                      src={image} 
                      alt={`${title} - Imagem ${index + 1}`}
                      loading={index === 0 ? "eager" : "lazy"} 
                      class="w-full rounded-lg object-cover"
                      width={1200}
                      height={800}
                    />
                    ))}
                </div>
                )}

            </div>
        </section>


        <!-- Voltar -->
        <div class="mt-12 text-center">
            <a href="/projects"
                class="inline-block rounded-md bg-gray-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-gray-700">
                Ver mais projetos
            </a>
        </div>

    </main>

    <!-- Schema.org Structured Data for BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://studioagartha.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Projetos",
          "item": "https://studioagartha.com/projects"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": projectUrl
        }
      ]
    })}></script>
</Layout>
