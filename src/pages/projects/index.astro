---
import Layout from "../../layouts/Layout.astro";
import ProjectThumbnail from "../../components/ProjectThumbnail.astro";
import { getCollection } from "astro:content";
import { ArrowRight } from "@lucide/astro";
import { localePath, localizeProject, ui, type Locale } from '../../i18n/ui';

interface Props { locale?: Locale }
const { locale = 'pt' } = Astro.props;
const copy = ui[locale];
const projects = await getCollection("projects");
const projectCategory = (project: (typeof projects)[number]) =>
  localizeProject(locale, project.id, project.data.description, project.data.categories).categories[0];
const filters = [
  { value: 'all', label: locale === 'es' ? 'Todos' : locale === 'en' ? 'All' : 'Todos' },
  { value: 'editorial', label: locale === 'es' ? 'Editorial' : locale === 'en' ? 'Editorial' : 'Editorial' },
  { value: 'identity', label: locale === 'es' ? 'Identidad visual' : locale === 'en' ? 'Visual identity' : 'Identidade visual' },
];
---

<Layout 
  title={`${copy.projects} | Estúdio Agartha`}
  description={copy.seoDescription}
  type="webpage"
  locale={locale}
>
    <section class="mx-auto max-w-6xl px-6 py-8">
        <!-- Breadcrumbs -->
        <nav class="mb-8 text-center text-sm" aria-label={copy.breadcrumb}>
          <ol class="flex flex-wrap items-center justify-center gap-2">
            <li>
              <a href={localePath(locale)} class="text-brand hover:text-brand-active transition-colors">
                {copy.home}
              </a>
            </li>
            <li class="text-gray-400">/</li>
            <li class="text-gray-600" aria-current="page">
              {copy.projects}
            </li>
          </ol>
        </nav>
    </section>

    <section id="projetos" class="my-5 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <div class="mx-auto max-w-7xl text-left">

            <h1 class="mb-8 text-2xl font-semibold text-brand sm:text-3xl">
                {copy.projectListTitle}
            </h1>

            <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label={locale === 'es' ? 'Filtrar proyectos' : locale === 'en' ? 'Filter projects' : 'Filtrar projetos'}>
                {filters.map((filter, index) => (
                  <button type="button" data-project-filter={filter.value} aria-pressed={index === 0 ? 'true' : 'false'}
                    class:list={['rounded-xl border px-4 py-2 text-sm transition-colors', index === 0 ? 'border-brand bg-brand-strong text-white' : 'border-gray-200 text-ink hover:border-brand']}>
                    {filter.label}
                  </button>
                ))}
            </div>

            <div class="grid gap-6 md:grid-cols-3">

                {projects.map((project) => (
                <article data-project-type={project.data.categories.includes('Design Editorial') ? 'editorial' : 'identity'}
                    class="overflow-hidden rounded-[2rem] bg-surface-muted shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

                    <ProjectThumbnail src={project.data.cover} alt={`${project.data.title} - ${projectCategory(project)}`} />

                    <div class="px-5 py-5 text-center">

                        <h2 class="mb-1 text-base font-semibold text-brand">
                            {project.data.title}
                        </h2>

                        <p class="mb-2 text-sm">
                            {projectCategory(project)}
                        </p>

                        <a href={localePath(locale, `projects/${project.id}`)}
                            class="inline-flex items-center gap-1 text-sm text-gray-500 transition-colors hover:text-brand">
                            <span>{copy.projectDetails}</span>
                            <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
                        </a>

                    </div>

                </article>
                ))}

            </div>

        </div>
    </section>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-type]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const selected = button.dataset.projectFilter;
    buttons.forEach((item) => {
      const active = item === button;
      item.setAttribute('aria-pressed', String(active));
      item.classList.toggle('border-brand', active);
      item.classList.toggle('bg-brand-strong', active);
      item.classList.toggle('text-white', active);
      item.classList.toggle('border-gray-200', !active);
      item.classList.toggle('text-ink', !active);
    });
    cards.forEach((card) => card.classList.toggle('hidden', selected !== 'all' && card.dataset.projectType !== selected));
  }));
</script>
</Layout>
