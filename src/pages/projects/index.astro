---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { localePath, localizeProject, ui, type Locale } from '../../i18n/ui';

interface Props { locale?: Locale }
const { locale = 'pt' } = Astro.props;
const copy = ui[locale];
const projects = await getCollection("projects");
const projectCategory = (project: (typeof projects)[number]) =>
  localizeProject(locale, project.id, project.data.description, project.data.categories).categories[0];
---

<Layout 
  title={`${copy.projects} | Estúdio Agartha`}
  description={copy.seoDescription}
  type="webpage"
  locale={locale}
>
    <section class="mx-auto max-w-6xl px-6 py-8">
        <!-- Breadcrumbs -->
        <nav class="mb-8 text-sm" aria-label={copy.breadcrumb}>
          <ol class="flex items-center gap-2">
            <li>
              <a href={localePath(locale)} class="text-[#00a69c] hover:text-[#009186] transition-colors">
                {copy.home}
              </a>
            </li>
            <li class="text-gray-400">/</li>
            <li class="text-gray-600" aria-current="page">
              {copy.projects}
            </li>
          </ol>
        </nav>
    </section>

    <section id="projetos" class="my-5 rounded-3xl bg-white px-4 py-10 sm:px-6 lg:px-12">
        <div class="mx-auto max-w-7xl text-left">

            <h1 class="mb-8 text-2xl font-semibold text-[#00a69c] sm:text-3xl">
                {copy.projectListTitle}
            </h1>

            <div class="grid gap-6 md:grid-cols-3">

                {projects.map((project) => (
                <article
                    class="overflow-hidden rounded-[2rem] bg-[#e1e4ed] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

                    <Image src={project.data.cover} alt={`${project.data.title} - ${projectCategory(project)}`} loading="lazy"
                        class="h-[375px] w-full object-cover" />

                    <div class="px-5 py-5 text-center">

                        <h2 class="mb-1 text-base font-semibold text-[#00a69c]">
                            {project.data.title}
                        </h2>

                        <p class="mb-2 text-sm">
                            {projectCategory(project)}
                        </p>

                        <a href={localePath(locale, `projects/${project.id}`)}
                            class="inline-flex items-center gap-1 text-sm text-gray-500 transition-colors hover:text-[#00a69c]">
                            <span>{copy.projectDetails}</span>
                            <span class="text-xs">→</span>
                        </a>

                    </div>

                </article>
                ))}

            </div>

        </div>
    </section>
</Layout>
