---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DrawerForm from '../components/DrawerForm.astro';
const { title = 'Estúdio Agartha', description = 'Design criativo que transforma marcas. Especialistas em identidade visual, branding, websites, embalagens e conteúdos para redes sociais.' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
</head>

<body class="min-h-screen bg-[#e5e5e5] text-slate-900 antialiased">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <Header />
        <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <slot />
        </main>
        <Footer />
    </div>
    <DrawerForm />
</body>

</html>
