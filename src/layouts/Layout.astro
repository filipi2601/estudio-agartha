---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DrawerForm from '../components/DrawerForm.astro';
import SEO from '../components/SEO.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: 'article' | 'organization' | 'webpage' | 'product';
  author?: string;
  publishedDate?: string;
  modifiedDate?: string;
  noindex?: boolean;
  locale?: Locale;
}

const { 
  title = 'Estúdio Agartha',
  locale = 'pt',
  description = ui[locale].seoDescription,
  image,
  url = Astro.url.href,
  type = 'webpage',
  author = 'Estúdio Agartha',
  publishedDate,
  modifiedDate,
  noindex = false,
} = Astro.props;
const copy = ui[locale];
---

<!doctype html>
<html lang={copy.htmlLang} class="scroll-smooth">

<head>
    <SEO 
      title={title}
      description={description}
      image={image}
      url={url}
      type={type}
      author={author}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      noindex={noindex}
      locale={locale}
    />
    <title>{title}</title>
</head>

<body class="min-h-screen bg-[#e5e5e5] text-slate-900 antialiased">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <Header locale={locale} pathname={Astro.url.pathname} />
        <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <slot />
        </main>
        <Footer locale={locale} />
    </div>
    <DrawerForm locale={locale} />
    <script>
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal], main > section, main > article');

        revealTargets.forEach((target) => target.dataset.reveal = '');
        document.documentElement.classList.add('motion-ready');

        if (reduceMotion || !('IntersectionObserver' in window)) {
            revealTargets.forEach((target) => target.classList.add('is-visible'));
        } else {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });

            revealTargets.forEach((target) => observer.observe(target));
        }
    </script>
</body>

</html>
