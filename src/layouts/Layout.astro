---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DrawerForm from '../components/DrawerForm.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  url?: string;
  type?: 'article' | 'organization' | 'webpage' | 'product';
  author?: string;
  publishedDate?: string;
  modifiedDate?: string;
  noindex?: boolean;
}

const { 
  title = 'Estúdio Agartha',
  description = 'Design criativo que transforma marcas. Especialistas em identidade visual, branding, websites, embalagens e conteúdos para redes sociais.',
  url = Astro.url.href,
  type = 'webpage',
  author = 'Estúdio Agartha',
  publishedDate,
  modifiedDate,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">

<head>
    <SEO 
      title={title}
      description={description}
      url={url}
      type={type}
      author={author}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      noindex={noindex}
    />
    <title>{title}</title>
</head>

<body class="min-h-screen bg-[#e5e5e5] text-slate-900 antialiased">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <Header />
        <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <slot />
        </main>
        <Footer />
    </div>
    <DrawerForm />
</body>

</html>
