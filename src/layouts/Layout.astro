---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DrawerForm from '../components/DrawerForm.astro';
import SEO from '../components/SEO.astro';
import Analytics from '../components/Analytics.astro';
import { ArrowUp } from '@lucide/astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: 'article' | 'organization' | 'webpage' | 'product';
  author?: string;
  publishedDate?: string;
  modifiedDate?: string;
  noindex?: boolean;
  locale?: Locale;
}

const { 
  title = 'Estúdio Agartha',
  locale = 'pt',
  description = ui[locale].seoDescription,
  image,
  url = Astro.url.href,
  type = 'webpage',
  author = 'Estúdio Agartha',
  publishedDate,
  modifiedDate,
  noindex = false,
} = Astro.props;
const copy = ui[locale];
const backToTopLabel = { pt: 'Voltar ao início', en: 'Back to top', es: 'Volver al inicio' }[locale];
---

<!doctype html>
<html lang={copy.htmlLang} class="scroll-smooth">

<head>
    <SEO 
      title={title}
      description={description}
      image={image}
      url={url}
      type={type}
      author={author}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      noindex={noindex}
      locale={locale}
    />
    <title>{title}</title>
    {Astro.url.pathname === '/' && <script is:inline>
      let chosen;
      try { chosen = localStorage.getItem('agartha-language'); } catch { /* Storage can be unavailable. */ }
      const language = chosen || (navigator.language || 'en').toLowerCase().split('-')[0];
      const destination = language === 'pt' ? null : language === 'es' ? 'es' : 'en';
      if (destination) location.replace(`/${destination}/${location.search}${location.hash}`);
    </script>}
</head>

<body class="min-h-screen bg-canvas text-slate-900 antialiased">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <Header locale={locale} pathname={Astro.url.pathname} />
        <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <slot />
        </main>
        <Footer locale={locale} />
    </div>
    <DrawerForm locale={locale} />
    <Analytics locale={locale} />
    <button type="button" data-back-to-top inert aria-hidden="true" aria-label={backToTopLabel}
        class="pointer-events-none fixed bottom-5 right-5 z-30 grid h-12 w-12 translate-y-3 place-items-center rounded-full border border-white/25 bg-brand-strong/90 text-white opacity-0 shadow-lg backdrop-blur-sm transition-[opacity,transform,background-color] duration-300 hover:bg-brand-strong focus-visible:outline-white sm:bottom-8 sm:right-8">
        <ArrowUp class="h-5 w-5" aria-hidden="true" />
    </button>
    <script>
        document.querySelectorAll<HTMLAnchorElement>('[data-language-choice]').forEach((link) => {
            link.addEventListener('click', () => {
                try { localStorage.setItem('agartha-language', link.dataset.languageChoice!); } catch { /* Storage can be unavailable. */ }
            });
        });
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        const updateBackToTop = () => {
            if (!backToTop) return;
            const remaining = document.documentElement.scrollHeight - window.scrollY - window.innerHeight;
            const visible = window.scrollY > window.innerHeight && remaining < window.innerHeight * 1.25;
            backToTop.classList.toggle('opacity-0', !visible);
            backToTop.classList.toggle('translate-y-3', !visible);
            backToTop.classList.toggle('pointer-events-none', !visible);
            backToTop.toggleAttribute('inert', !visible);
            backToTop.setAttribute('aria-hidden', String(!visible));
        };
        window.addEventListener('scroll', updateBackToTop, { passive: true });
        window.addEventListener('resize', updateBackToTop);
        backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));
        updateBackToTop();
        const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal], main > section, main > article');

        revealTargets.forEach((target) => target.dataset.reveal = '');
        document.documentElement.classList.add('motion-ready');

        if (reduceMotion || !('IntersectionObserver' in window)) {
            revealTargets.forEach((target) => target.classList.add('is-visible'));
        } else {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });

            revealTargets.forEach((target) => observer.observe(target));
        }
    </script>
</body>

</html>
